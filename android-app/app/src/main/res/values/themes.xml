<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Pre-Compose launch window. Colours are driven by the Compose theme; this
         only styles the brief window before Compose draws, so it must track
         day/night to avoid a white flash. Bars are transparent for edge-to-edge. -->
    <style name="Theme.PhotoRestorer" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/brand_bg</item>
    </style>
</resources>
